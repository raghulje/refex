    {
      "fieldname": "revenue_section",
      "fieldtype": "Section Break",
      "label": "Revenue"
    },
    {
      "fieldname": "customer_rate",
      "fieldtype": "Currency",
      "label": "Customer Rate",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "customer_value",
      "fieldtype": "Currency",
      "label": "Customer Value",
      "in_list_view": 1,
      "columns": 2
