    {
      "fieldname": "service_item_details_section",
      "fieldtype": "Section Break",
      "label": "Service Item Details"
    },
    {
      "fieldname": "loading",
      "fieldtype": "Table",
      "label": "Loading",
      "options": "Trip Loading Details",
      "in_list_view": 0
    },
    {
      "fieldname": "transportation",
      "fieldtype": "Table",
      "label": "Transportation",
      "options": "Trip Transportation Details",
      "in_list_view": 0
    },
    {
      "fieldname": "unloading",
      "fieldtype": "Table",
      "label": "Unloading",
      "options": "Trip Unloading Details",
      "in_list_view": 0
    },
    {
