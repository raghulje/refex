    {
      "fieldname": "attachment_section",
      "fieldtype": "Section Break",
      "label": "Attachment"
    },
    {
      "fieldname": "challan_document",
      "fieldtype": "Attach",
      "label": "Challan / Document",
      "in_list_view": 0,
      "columns": 4
