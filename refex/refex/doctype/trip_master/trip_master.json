      "fieldtype": "Link",
      "label": "Project Name",
      "options": "Project",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "project_code",
      "fieldtype": "Data",
      "label": "Project Code",
      "fetch_from": "project_name.name",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "loa_name",
      "fieldtype": "Link",
      "label": "LOA Name",
      "options": "Sales Order",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "time_date_month",
      "fieldtype": "Datetime",
